{
  "manifest_version": 3,
  "name": "Word Crawler",
  "version": "2.4.0",
  "description": "Un ragno che legge pagine web, PDF (anche scansionati), documenti Word e immagini: sottolinea, cerchia, riassume, prepara le schede di ripasso e salva. Senza intelligenza artificiale.",
  "author": "Davide Di Filippo",
  "homepage_url": "https://github.com/davide0707/word-crawler",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Word Crawler: apri il pannello",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "restore.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-crawler": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Avvia o ferma il ragno sulla pagina"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
