{
  "name": "word-crawler-studio",
  "productName": "Word Crawler",
  "version": "2.1.0",
  "description": "Un ragno che legge documenti, PDF (anche scansionati, con Tesseract) e pagine web in sei lingue: sottolinea, cerchia, riassume, prepara le schede di ripasso e scansiona il disco. Senza intelligenza artificiale.",
  "homepage": "https://github.com/davide0707/word-crawler",
  "repository": {
    "type": "git",
    "url": "https://github.com/davide0707/word-crawler.git"
  },
  "main": "desktop/main.js",
  "private": true,
  "author": {
    "name": "Word Crawler",
    "email": "wordcrawler@example.invalid"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/analysis.test.js && node tests/export.test.js && node tests/scanner.test.js && node tests/main.test.js && node tests/formats.test.js && node tests/reader.test.js",
    "test:ui": "node tests/desktop-ui.test.js",
    "fixtures": "python3 tests/make-fixtures.py",
    "build:extension": "node scripts/build-extension.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test:extension": "node tests/extension.test.js",
    "fixtures:ocr": "python3 tests/make-ocr-fixtures.py"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright": "1.48.2"
  },
  "build": {
    "appId": "it.wordcrawler.studio",
    "productName": "Word Crawler",
    "copyright": "Word Crawler",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "core/**/*",
      "build/icons/**/*",
      "THIRD-PARTY.md",
      "!**/*.map",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/tesseract.js/src/**",
      "!node_modules/tesseract.js/docs/**",
      "!node_modules/tesseract.js/examples/**",
      "!node_modules/tesseract.js/tests/**",
      "!node_modules/tesseract.js-core/tesseract-core.wasm*",
      "!node_modules/tesseract.js-core/tesseract-core-simd.wasm*",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.wasm*"
    ],
    "asarUnpack": [
      "desktop/scanner.js",
      "desktop/scan-worker.js"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Documento Word",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Viewer"
      },
      {
        "ext": "doc",
        "name": "Documento Word 97-2003",
        "mimeType": "application/msword",
        "role": "Viewer"
      },
      {
        "ext": "odt",
        "name": "Documento OpenDocument",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "Libro EPUB",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": "rtf",
        "name": "Documento RTF",
        "mimeType": "application/rtf",
        "role": "Viewer"
      },
      {
        "ext": "md",
        "name": "Testo Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "Testo",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Word Crawler",
      "artifactName": "Word-Crawler-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Word-Crawler-Portatile-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icons/icon.png",
      "artifactName": "Word-Crawler-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icons/icon.png",
      "artifactName": "Word-Crawler-${version}-${arch}.${ext}",
      "maintainer": "Word Crawler <wordcrawler@example.invalid>"
    }
  }
}
